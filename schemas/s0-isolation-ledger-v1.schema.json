{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Reimangod/v5-matched-work-study/schemas/s0-isolation-ledger-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "stage",
    "status",
    "isolation_method",
    "repository",
    "historical_parent",
    "upstream_ceo_star",
    "dependency_lock",
    "required_imports",
    "historical_artifacts",
    "new_namespaces",
    "safety",
    "host_diagnostics",
    "claim_boundary",
    "decision",
    "next_stage_authorized",
    "ledger_digest"
  ],
  "properties": {
    "schema": {"const": "v5-matched-work.s0-isolation-ledger.v1"},
    "stage": {"const": "S0"},
    "status": {"const": "COMPLETE"},
    "isolation_method": {"const": "git-submodule"},
    "repository": {"type": "object"},
    "historical_parent": {"type": "object"},
    "upstream_ceo_star": {"type": "object"},
    "dependency_lock": {"type": "object"},
    "required_imports": {"type": "array", "minItems": 1},
    "historical_artifacts": {"type": "object"},
    "new_namespaces": {"type": "object"},
    "safety": {"type": "object"},
    "host_diagnostics": {"type": "object"},
    "claim_boundary": {"type": "string", "minLength": 1},
    "decision": {"enum": ["GO_S1", "NO_GO_S0"]},
    "next_stage_authorized": {"enum": ["S1", "NONE"]},
    "ledger_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
