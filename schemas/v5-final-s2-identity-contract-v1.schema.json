{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Reimangod/v5-matched-work-study/schemas/v5-final-s2-identity-contract-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "protocol_id", "stage", "status", "identity_layers",
    "deduplication", "canonicalization", "academic_integrity", "systems_safety",
    "authorization", "claim_boundary", "decision", "contract_digest"
  ],
  "properties": {
    "schema": {"const": "v5-final.s2-identity-contract.v1"},
    "protocol_id": {"const": "sequential-rebuilding-v1"},
    "stage": {"const": "S2"},
    "status": {"const": "COMPLETE"},
    "identity_layers": {
      "type": "object",
      "required": ["CandidateIntentID", "ProposedPhysicalStateID", "ExecutionRequestID"],
      "properties": {
        "CandidateIntentID": {"type": "array", "minItems": 5, "uniqueItems": true},
        "ProposedPhysicalStateID": {"type": "array", "minItems": 9, "uniqueItems": true},
        "ExecutionRequestID": {"type": "array", "minItems": 9, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "deduplication": {"type": "object"},
    "canonicalization": {"type": "object"},
    "academic_integrity": {"type": "object"},
    "systems_safety": {"type": "object"},
    "authorization": {
      "type": "object",
      "required": ["next_stage", "performance_experiment", "candidate_molecular_energy_evaluation", "s5_freeze"],
      "properties": {
        "next_stage": {"const": "S3"},
        "performance_experiment": {"const": "NOT_AUTHORIZED"},
        "candidate_molecular_energy_evaluation": {"const": "NOT_AUTHORIZED"},
        "s5_freeze": {"const": "NOT_AUTHORIZED"}
      }
    },
    "claim_boundary": {"type": "string", "minLength": 1},
    "decision": {"const": "GO_S3_ONLY"},
    "contract_digest": {"pattern": "^[0-9a-f]{64}$"}
  }
}
