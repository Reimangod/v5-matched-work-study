{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Reimangod/v5-matched-work-study/schemas/v5-final-s0-successor-isolation-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "protocol_id",
    "stage",
    "status",
    "baseline",
    "historical_tags",
    "provenance",
    "scientific_scope",
    "authorization",
    "systems_safety",
    "dual_gate",
    "decision",
    "manifest_digest"
  ],
  "properties": {
    "schema": {"const": "v5-final.s0-successor-isolation.v1"},
    "protocol_id": {"const": "sequential-rebuilding-v1"},
    "stage": {"const": "S0"},
    "status": {"const": "COMPLETE"},
    "baseline": {
      "type": "object",
      "required": ["tag", "peeled_commit", "tree_sha1", "file_count", "inventory", "allowed_modifications"],
      "properties": {
        "tag": {"const": "v5-matched-work-pre-s5-no-go-v4"},
        "peeled_commit": {"pattern": "^[0-9a-f]{40}$"},
        "tree_sha1": {"pattern": "^[0-9a-f]{40}$"},
        "file_count": {"type": "integer", "minimum": 1},
        "inventory": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "mode", "kind", "git_object"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "mode": {"type": "string"},
              "kind": {"enum": ["blob", "commit"]},
              "git_object": {"pattern": "^[0-9a-f]{40}$"},
              "sha256": {"pattern": "^[0-9a-f]{64}$"}
            },
            "additionalProperties": false
          }
        },
        "allowed_modifications": {"type": "array"}
      },
      "additionalProperties": false
    },
    "historical_tags": {"type": "array", "minItems": 5},
    "provenance": {"type": "object"},
    "scientific_scope": {
      "type": "object",
      "required": ["central_hypothesis", "primary_method", "secondary_method", "allowed_claims", "prohibited_claims"]
    },
    "authorization": {
      "type": "object",
      "required": ["current_stage", "next_stage", "performance_experiment", "candidate_molecular_energy_evaluation", "s5_freeze", "unlock_condition"],
      "properties": {
        "current_stage": {"const": "S0"},
        "next_stage": {"const": "S1"},
        "performance_experiment": {"const": "NOT_AUTHORIZED"},
        "candidate_molecular_energy_evaluation": {"const": "NOT_AUTHORIZED"},
        "s5_freeze": {"const": "NOT_AUTHORIZED"},
        "unlock_condition": {"type": "string", "minLength": 1}
      }
    },
    "systems_safety": {"type": "object"},
    "dual_gate": {
      "type": "object",
      "required": ["academic_integrity", "systems_safety"],
      "properties": {
        "academic_integrity": {"type": "array", "minItems": 3},
        "systems_safety": {"type": "array", "minItems": 3}
      }
    },
    "decision": {"const": "GO_S1_ONLY"},
    "manifest_digest": {"pattern": "^[0-9a-f]{64}$"}
  }
}
